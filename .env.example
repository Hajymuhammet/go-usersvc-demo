# Application Environment
APP_ENV=development

# Server
SERVER_PORT=8080
GRPC_PORT=50051

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=usersdb
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication - Generate a strong secret using: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-change-me-in-production
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
